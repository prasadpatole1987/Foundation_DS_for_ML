[user]
	name = prasadpatole1987
	email = prasad.patole1987@example.com

[core]
	editor = code
	excludesfile = .gitignore
	autocrlf = true
	ignorecase = false

[push]
	default = current

[pull]
	rebase = false

[merge]
	tool = vscode

[mergetool "vscode"]
	cmd = code --wait $MERGED

[diff]
	tool = vscode

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[commit]
	gpgSign = false

[fetch]
	prune = true
